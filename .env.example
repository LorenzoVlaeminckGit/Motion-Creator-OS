# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Free / Open-Weight AI Providers (configure in Settings > Secrets)
# ZAI_API_KEY: Z.ai / Zhipu free GLM-4.7-Flash & GLM-4.6V-Flash models
ZAI_API_KEY=""
# OPENROUTER_API_KEY: Access :free models (DeepSeek R1, Qwen 3.8, Nemotron, Gemma 4, openrouter/free)
OPENROUTER_API_KEY=""
# GROQ_API_KEY: Free ultra-fast Llama 3.3 70B & open models on Groq LPU
GROQ_API_KEY=""
# NVIDIA_API_KEY: NVIDIA NIM free developer tier (DeepSeek R1, Llama, Qwen)
NVIDIA_API_KEY=""
# MISTRAL_API_KEY: Mistral AI Experiment free tier (Mistral Small)
MISTRAL_API_KEY=""
# POLLINATIONS_API_KEY: Pollinations API token (enter.pollinations.ai) for DeepSeek V3 / R1 / Qwen Coder
POLLINATIONS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
